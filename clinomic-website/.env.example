# Server Port
PORT=5500

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clinomic?retryWrites=true&w=majority

# Gmail SMTP Configuration for sending notifications
# EMAIL_USER: Your Gmail address from which notifications will be sent
EMAIL_USER=your_sender_gmail@gmail.com

# EMAIL_PASS: 16-character Google App Password (NOT your normal Gmail password)
# Generated from: https://myaccount.google.com/apppasswords
EMAIL_PASS=abcd1234efgh5678

# Destination Email where candidate enrollments will be delivered
NOTIFICATION_EMAIL=nmdonni@gmail.com
